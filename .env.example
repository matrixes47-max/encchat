# enc.chat v4.1 Environment Configuration

# Server Configuration
NODE_ENV=production
PORT=3000

# Security Features
TOR_ENABLED=false                # Enable Tor hidden service support
TRUST_PROXY=false                # Trust X-Forwarded-For headers (needed for Tor/reverse proxy)

# Rate Limiting (requests per minute)
RATE_LIMIT_MAX_REQUESTS=60       # General API rate limit
RATE_LIMIT_MESSAGE_MAX=20        # Message posting rate limit

# TTL Configuration (in seconds)
MIN_TTL=10                       # Minimum message lifetime
MAX_TTL=86400                    # Maximum message lifetime (24 hours)
DEFAULT_TTL=300                  # Default message lifetime (5 minutes)

# Room Limits
MAX_MESSAGES_PER_ROOM=500        # Maximum messages per room
MAX_KEYS_PER_ROOM=10             # Maximum participants per room

# Cleanup Intervals (in milliseconds)
CLEANUP_INTERVAL=30000           # Message/key cleanup (30 seconds)
RATE_LIMIT_CLEANUP=120000        # Rate limit cleanup (2 minutes)

# Size Limits
MAX_ROOM_LENGTH=128              # Maximum room name length
MAX_SID_LENGTH=64                # Maximum session ID length
MAX_MESSAGE_SIZE=16384           # Maximum message size (16KB)
MAX_REQUEST_SIZE=65536           # Maximum HTTP request body size (64KB)

# Production Deployment Examples:

# ── Railway.app ──
# PORT=3000 (auto-set by Railway)
# TOR_ENABLED=false
# TRUST_PROXY=true (Railway uses reverse proxy)

# ── Tor Hidden Service ──
# TOR_ENABLED=true
# TRUST_PROXY=true
# Configure Tor separately (see tor/torrc.example)

# ── Behind Nginx/Apache ──
# PORT=3000
# TOR_ENABLED=false
# TRUST_PROXY=true

# ── Standalone VPS ──
# PORT=3000
# TOR_ENABLED=false
# TRUST_PROXY=false
